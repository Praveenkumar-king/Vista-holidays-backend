PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,https://vista-holidays-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vista-holidays-frontend.vercel.app

# Database
MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Brevo SMTP Email Service
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_FROM_EMAIL=noreply@vistaholidays.com
BREVO_FROM_NAME=Vista Holidays

# Admin Notification Recipient
ADMIN_NOTIFICATION_EMAIL=admin@vistaholidays.com

# Existing Services (Preserved)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENWEATHER_API_KEY=
PEXELS_API_KEY=
IMAGE_API_KEY=

# Cloudinary Configuration (Product Updates Slide Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vista-holidays/product-updates

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
